      <aliases enabled='yes' />
      <column caption='Total Loan Applications' datatype='integer' name='[Calculation_0926341110620160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='MTD Total Loan Applications' datatype='integer' name='[Calculation_0926341125783567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF &#13;&#10;DATEDIFF(&apos;month&apos;,[issue_date], {MAX([issue_date])}) = 0&#13;&#10;THEN&#13;&#10;[id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='MoM Loan Apllications' datatype='real' name='[Calculation_0926341130092569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0926341125783567]-[MTD Total Loan Applications (copy)_0926341129052182])&#13;&#10;/&#13;&#10;[MTD Total Loan Applications (copy)_0926341129052182]' />
      </column>
      <column caption='Total Funded Amount' datatype='integer' name='[Calculation_0926341131280410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loan_amount])' />
      </column>
      <column caption='MoM Total Funded Amount' datatype='real' name='[Calculation_0926341140770845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Total Loan Applications (copy)_0926341138550811] - [MTD Total Funded Amount (copy)_0926341140492316])/[MTD Total Funded Amount (copy)_0926341140492316]' />
      </column>
      <column caption='Total Amount Received' datatype='integer' name='[Calculation_0926341142155294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_payment])' />
      </column>
      <column caption='MoM Amount Received' datatype='real' name='[Calculation_0926341146357793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Total Funded Amount (copy)_0926341145083935] - [MTD Total  Amount Received (copy)_0926341146120224]) / [MTD Total  Amount Received (copy)_0926341146120224]' />
      </column>
      <column caption='Average Intrst Rate' datatype='real' name='[Calculation_0926341147836450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([int_rate])' />
      </column>
